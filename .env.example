SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — si se omite, usa db.sqlite3 local.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS — coma-separados. Solo poner CORS_ALLOW_ALL_ORIGINS=True en desarrollo.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
CORS_ALLOW_ALL_ORIGINS=False

# Email — dos formas:
#
# (A) Resend por API HTTP (RECOMENDADO en PaaS que bloquean SMTP, p. ej. Railway):
#   EMAIL_BACKEND=autotestAPI.email_backends.ResendEmailBackend
#   RESEND_API_KEY=re_xxx
#   DEFAULT_FROM_EMAIL=AutoTest <no-reply@auto-test.cl>
#
# (B) SMTP genérico (Gmail dev, o Resend/SendGrid/SES por SMTP si el puerto no está bloqueado):
#   EMAIL_HOST=smtp.resend.com  EMAIL_PORT=587  EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=resend      EMAIL_HOST_PASSWORD=<api-key>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# RESEND_API_KEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente de los correos. Si se omite, usa "AutoTest <EMAIL_HOST_USER>".
# DEBE coincidir con la cuenta autenticada (EMAIL_HOST_USER) o Gmail lo rechaza.
# DEFAULT_FROM_EMAIL=AutoTest <soporte.alvolante@gmail.com>

# URL pública del frontend (usada en links de email de reset/activación)
FRONTEND_URL=http://localhost:3000

# Destinatarios de reportes de error 500. Coma-separado, "Nombre <correo>" o "correo".
# ADMINS=Gabriel <alfons.diaz97@gmail.com>

# Error tracking (opcional). Sin SENTRY_DSN no se inicializa Sentry.
# SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Nombre mostrado por la app autenticadora en el enrolamiento 2FA (TOTP)
TOTP_ISSUER=AutoTest

# Transbank / Webpay Plus.
# Sin definir -> ambiente de INTEGRACIÓN (plata simulada, credenciales de prueba).
# Para pagos reales en producción:
#   TBK_ENVIRONMENT=LIVE
#   TBK_COMMERCE_CODE=<código de comercio productivo>
#   TBK_API_KEY=<api key productiva>
TBK_ENVIRONMENT=TEST

# Medios de cursos (audios, figuras y PDFs de páginas del libro). Solo los usan los
# comandos locales generate_media / publish_media; el backend desplegado solo guarda las URLs.
# 'local' = MEDIA_ROOT (dev). 's3' = bucket S3-compatible con URL pública (Cloudflare R2 o AWS S3).
# (Los nombres viejos AUDIO_STORAGE / AUDIO_S3_* siguen funcionando como alias.)
# MEDIA_STORAGE=s3
# MEDIA_S3_BUCKET=autotest-media
# MEDIA_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com   # vacío en AWS
# MEDIA_S3_REGION=auto                                                  # región en AWS
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_PUBLIC_BASE_URL=https://media.auto-test.cl                   # dominio propio (r2.dev solo para pruebas)
# AUDIO_S3_PREFIX=course_audio/
# IMAGES_S3_PREFIX=course_images/
# DOCS_S3_PREFIX=course_docs/
