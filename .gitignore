# Secrets / local config
.env
.env.local
*.env

# SQLite
db.sqlite3
db.sqlite3-journal

# Virtualenv
env/
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Media / static (uploads)
/media/
staticfiles/

# Content pipeline — no versionar datos de entrada/salida (PDFs, JSON, reportes).
# Se conserva solo el esqueleto de carpetas vía .gitkeep.
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
!data/output/*/
data/output/*/*
!data/output/*/.gitkeep

# Generación de cursos — insumos y artefactos dejados en la raíz del proyecto
# (no versionar). Los PDFs de origen y los JSON generados por `generate_course`
# son datos, no código. Tip: escribir --out bajo data/output/ los ignora igual.
/*.pdf
/curso_*.json
/prueba*.json
/ejercicios_*.json
/out/*.json

# IDE
.vscode/
.idea/
*.swp
.DS_Store
